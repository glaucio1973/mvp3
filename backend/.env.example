# Copie este arquivo para .env e preencha os valores

# Banco de dados MySQL (ISBrasil)
DATABASE_URL="mysql://liessin_cantina:SUA_SENHA@liessin_consulta.liessin.com.br:3306/liessin_cantina"

# JWT (troque por uma string longa e aleatória)
JWT_SECRET="troque-por-uma-chave-secreta-longa"

# Porta do servidor (cPanel geralmente define PORT automaticamente)
PORT=3001

# Ambiente
NODE_ENV=production

# Origens permitidas (domínio do site — deixe vazio para permitir tudo)
# CORS_ORIGIN=https://seusite.com.br
